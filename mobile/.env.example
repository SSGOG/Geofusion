# Use the local Docker/FastAPI API while developing on the same Wi-Fi or hotspot network.
EXPO_PUBLIC_GEOFUSION_API_URL=http://192.168.1.5:8000

# Use the project URL (not its /rest/v1 endpoint) and publishable key.
# Never put a service_role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
